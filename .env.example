# Copy this file to .env and paste your keys after the = sign.
# .env is listed in .gitignore, so your keys never get uploaded to GitHub.

# From https://openrouter.ai/keys
OPENROUTER_API_KEY=

# From https://smith.langchain.com (Settings → API Keys). Needed for step 5.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=true
LANGSMITH_PROJECT=job-agent
